<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark Theme -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryVariant">@color/primary_green_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        
        <!-- Secondary colors -->
        <item name="colorSecondary">@color/cyan_accent</item>
        <item name="colorSecondaryVariant">@color/cyan_accent_dark</item>
        <item name="colorOnSecondary">@android:color/white</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnBackground">@android:color/white</item>
        <item name="colorOnSurface">@android:color/white</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        
        <!-- Custom attributes for Dark Theme -->
        <item name="white">@android:color/white</item>
        <item name="background_primary">@color/dark_background</item>
        <item name="background_dark">@android:color/white</item>
        <item name="surface_white">@color/dark_surface</item>
        <item name="input_background">@color/dark_input</item>
        <item name="background_input">@color/dark_input</item>
        <item name="background_card">@color/dark_surface</item>
        
        <!-- Text colors -->
        <item name="text_primary">@android:color/white</item>
        <item name="text_secondary">@color/light_gray</item>
        <item name="text_white">@android:color/white</item>
        <item name="text_gray">@color/light_gray</item>
        <item name="text_gray_light">@color/light_gray</item>
        <item name="text_muted">@color/medium_gray</item>
        
        <!-- Border and divider colors -->
        <item name="border_color">@color/dark_border</item>
        <item name="border_focus">@color/primary_green</item>
        <item name="divider_color">@color/dark_border</item>
        
        <!-- Button colors -->
        <item name="button_primary">@color/primary_green</item>
        <item name="button_secondary">@color/dark_surface</item>
        <item name="primary_background">@color/dark_background</item>
        <item name="primary_green">@color/primary_green</item>
        
        <!-- Tab colors -->
        <item name="tab_selected">@color/primary_green</item>
        <item name="tab_unselected">@color/light_gray</item>
        
        <!-- Accent colors -->
        <item name="cyan_accent">@color/cyan_accent</item>
    </style>
</resources>