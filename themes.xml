<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light Theme -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryVariant">@color/primary_green_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        
        <!-- Secondary colors -->
        <item name="colorSecondary">@color/cyan_accent</item>
        <item name="colorSecondaryVariant">@color/cyan_accent_dark</item>
        <item name="colorOnSecondary">@android:color/white</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@android:color/white</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnBackground">@android:color/black</item>
        <item name="colorOnSurface">@android:color/black</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        
        <!-- Custom attributes for Light Theme -->
        <item name="white">@android:color/white</item>
        <item name="background_primary">@android:color/white</item>
        <item name="background_dark">@android:color/black</item>
        <item name="surface_white">@android:color/white</item>
        <item name="input_background">@color/light_gray</item>
        <item name="background_input">@color/light_gray</item>
        <item name="background_card">@android:color/white</item>
        
        <!-- Text colors -->
        <item name="text_primary">@android:color/black</item>
        <item name="text_secondary">@color/dark_gray</item>
        <item name="text_white">@android:color/black</item>
        <item name="text_gray">@color/medium_gray</item>
        <item name="text_gray_light">@color/dark_gray</item>
        <item name="text_muted">@color/medium_gray</item>
        
        <!-- Border and divider colors -->
        <item name="border_color">@color/light_border</item>
        <item name="border_focus">@color/primary_green</item>
        <item name="divider_color">@color/light_border</item>
        
        <!-- Button colors -->
        <item name="button_primary">@color/primary_green</item>
        <item name="button_secondary">@android:color/white</item>
        <item name="primary_background">@android:color/white</item>
        <item name="primary_green">@color/primary_green</item>
        
        <!-- Tab colors -->
        <item name="tab_selected">@color/primary_green</item>
        <item name="tab_unselected">@color/medium_gray</item>
        
        <!-- Accent colors -->
        <item name="cyan_accent">@color/cyan_accent</item>
    </style>
</resources>